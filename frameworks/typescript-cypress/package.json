{
  "name": "qa-academy-typescript-cypress",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:book": "cypress run --spec \"tests/api/product_crud.spec.ts,tests/ui/playground_flaky.spec.ts,tests/ui/product_purchase_traceability.spec.ts\"",
    "test:desktop": "DEVICE_PROFILE=desktop cypress run",
    "test:mobile": "DEVICE_PROFILE=mobile cypress run --spec tests/ui/product_purchase_traceability.spec.ts",
    "test:api": "cypress run --spec \"tests/api/*.spec.ts\"",
    "test:ui": "cypress run --spec \"tests/ui/*.spec.ts\"",
    "verify": "cypress verify",
    "typecheck": "tsc --noEmit",
    "report": "allure generate --single-file allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@cypress/webpack-preprocessor": "6.0.4",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.35.1",
    "allure-cypress": "3.10.2",
    "allure-js-commons": "3.10.2",
    "babel-loader": "10.0.0",
    "cypress": "15.19.0",
    "dotenv": "17.4.2",
    "typescript": "7.0.2",
    "webpack": "5.102.1"
  }
}
