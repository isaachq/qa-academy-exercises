{
  "name": "qa-academy-typescript-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:book": "playwright test --grep BOOK-TEST",
    "test:desktop": "playwright test --project=desktop-chromium",
    "test:mobile": "playwright test --project=mobile-chromium",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "allure generate --single-file allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.35.1",
    "allure-playwright": "3.10.2",
    "dotenv": "17.4.2",
    "typescript": "7.0.2"
  }
}
